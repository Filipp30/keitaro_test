# Keitaro instance and Admin API key (Keitaro admin -> Profile -> API keys)
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# Any SQLAlchemy URL; SQLite by default, e.g. postgresql+psycopg://user:pass@localhost/keitaro
DATABASE_URL=sqlite:///./app.db

# Where stream #1 (geo filter) redirects to
GEO_REDIRECT_URL=https://www.google.com

# Optional: values pre-selected in the "create campaign" form
# (9799 = "VZ adrobot test" group, 1813 = kylovoa.com, 836 = FORTESTS on the test instance)
DEFAULT_GROUP_ID=9799
DEFAULT_DOMAIN_ID=1813
DEFAULT_TRAFFIC_SOURCE_ID=836
